# Import these into your deployment platform; this file is documentation, not automatically loaded.
ASPNETCORE_ENVIRONMENT=Production
Database__AutoMigrate=false
ConnectionStrings__TrainingDatabase=Server=YOUR_SERVER;Database=TrainingManagement;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=False
Jwt__SigningKey=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
BootstrapAdmin__Username=admin
BootstrapAdmin__Password=REPLACE_WITH_RANDOM_PASSWORD
Enterprise__RequireRegistrationApproval=true
Enterprise__WorkerEnabled=true
DataProtection__KeysPath=C:\TrainingManagement\protected-keys
Cors__Origins__0=https://training.example.com
Sso__Enabled=false
Sso__Authority=https://YOUR_IDENTITY_PROVIDER/TENANT
Sso__Issuer=https://YOUR_IDENTITY_PROVIDER/TENANT
Sso__ClientId=YOUR_REGISTERED_CLIENT_ID
Sso__ClientSecret=USE_SECRET_MANAGER
Sso__PublicOrigin=https://training.example.com
Mail__Enabled=false
Mail__Host=smtp.example.com
Mail__Port=587
Mail__From=training@example.com
Mail__Username=YOUR_SMTP_USER
Mail__Password=USE_SECRET_MANAGER
Hr__EmployeesEndpoint=https://hr.example.com/api/training-employees.csv
Hr__ApiKey=USE_SECRET_MANAGER
